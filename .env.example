# Copy this file to ".env" and fill in your real values.
# ".env" is git-ignored and must never be committed.

# --- MySQL database ---
DB_HOST=localhost
DB_PORT=3306
# A dedicated, least-privilege application account is strongly
# recommended over "root" for anything beyond local experimentation.
DB_USER=ai_cyberguard_app
DB_PASSWORD=your_mysql_password
DB_NAME=ai_cyberguard

# TLS to MySQL - optional, defaults to DISABLED (today's plain local
# behavior). Set to REQUIRED/VERIFY_CA/VERIFY_IDENTITY only if your
# MySQL server is actually configured for TLS; see
# database/connection.py for exactly what each mode does.
DB_SSL_MODE=DISABLED
DB_SSL_CA=

# --- VirusTotal API v3 ---
# Get a free key at https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_virustotal_api_key
# Minimum seconds between one user's URL scan submissions (server-side,
# database-backed - see security/url_scanner.py).
URL_SCAN_COOLDOWN_SECONDS=10

# --- Google Safe Browsing API v4 (optional second threat-intel source) ---
# Get a free key at https://developers.google.com/safe-browsing/v4/get-started
# Leave blank to scan with VirusTotal alone - this is purely additive.
GOOGLE_SAFE_BROWSING_API_KEY=

# --- Google OAuth ("Continue with Google" login) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application"). Authorized redirect URI
# must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8501/oauth2callback
# A long random secret that signs Streamlit's own login cookie - not
# from Google. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_COOKIE_SECRET=

# --- Session expiration ---
# Idle timeout: no page activity for this long ends the session.
SESSION_TIMEOUT_MINUTES=60
# Absolute timeout: hard ceiling on session lifetime even with
# continuous activity.
SESSION_ABSOLUTE_TIMEOUT_MINUTES=480

# --- Login brute-force throttling (auth/rate_limit.py) ---
# Per-ACCOUNT: short, bounded cooldown (can't be escalated into a
# permanent lockout of a real user). Per-SOURCE: longer cooldown, the
# real defense against credential stuffing.
LOGIN_ACCOUNT_MAX_ATTEMPTS=5
LOGIN_ACCOUNT_WINDOW_SECONDS=900
LOGIN_ACCOUNT_LOCKOUT_SECONDS=30
LOGIN_ACCOUNT_LOCKOUT_MAX_SECONDS=900
LOGIN_SOURCE_MAX_ATTEMPTS=20
LOGIN_SOURCE_WINDOW_SECONDS=900
LOGIN_SOURCE_LOCKOUT_SECONDS=900

# --- Upload limits (app_pages/threat_detection.py) ---
# Generous by default - well above the ~225k-row CICIDS2017 dataset -
# these bound worst-case memory use from a hostile/corrupt file, not
# realistic datasets.
MAX_UPLOAD_SIZE_MB=300
MAX_UPLOAD_ROWS=3000000
